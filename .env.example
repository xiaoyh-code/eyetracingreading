# Copy this file to .env. Keep keys on this computer; never put them in browser code.
# Optional: without a key, reading + demo translations + a small offline glossary work.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional offline Stable Diffusion WebUI (start your own server with --api).
# Only a loopback URL is accepted. Leave empty if not installed.
LOCAL_IMAGE_URL=

# TokenHub Hunyuan images (text translation remains offline).
# China-site Guangzhou endpoint; use your account's matching region/site endpoint.
# Choices: auto, tokenhub, tencent, local, openai.
# auto prefers local, then TokenHub, then Tencent Cloud API, then OpenAI.
IMAGE_PROVIDER=auto
TOKENHUB_API_KEY=
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
TOKENHUB_IMAGE_MODEL=hy-image-v3

# Alternative: Tencent Cloud signed API (SecretId + SecretKey, not a TokenHub key).
# Enable the Hunyuan image service in Tencent Cloud, then set your local credentials.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
# Optional short-lived session token:
TENCENT_TOKEN=
